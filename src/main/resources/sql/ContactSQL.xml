<?xml version="1.0" encoding="UTF-8"?>
<sql class="io.github.filsynyster.blockforge.app.repositories.ContactRepository">

    <query bind="findByName">
        SELECT * FROM contacts WHERE name = ?
    </query>

    <query bind="findByIdNative">
        SELECT * FROM contacts WHERE id = ?
    </query>

    <query bind="findAllNative">
        SELECT * FROM contacts
    </query>

    <query bind="findByAge">
        SELECT * FROM contacts WHERE age > 10
    </query>

    <query bind="findByAgeGreaterThan">
        SELECT * FROM contacts WHERE age > ?
    </query>

    <query bind="findAllAsSet">
        SELECT * FROM contacts
    </query>

</sql>